{
    "name": "vaults/php-client",
    "description": "Zero-dependency PHP client for the Vaults resilient Composer infrastructure API",
    "license": "MIT",
    "type": "library",
    "keywords": ["vaults", "composer", "mirror", "resilience"],
    "archive": {
        "exclude": ["/vendor", "/tests", "/.phpunit.cache", "/.github", "/phpunit.xml", "/phpstan.neon"]
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*"
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.0|^5.0",
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Vaults\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
