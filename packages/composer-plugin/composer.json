{
    "name": "vaults/composer-plugin",
    "description": "composer deposit: deposit your composer.lock with Vaults resilient Composer infrastructure",
    "license": "MIT",
    "type": "composer-plugin",
    "keywords": ["vaults", "composer", "plugin", "mirror", "resilience"],
    "require": {
        "php": ">=8.2",
        "composer-plugin-api": "^2.3",
        "vaults/php-client": "@dev"
    },
    "require-dev": {
        "composer/composer": "^2.7",
        "pestphp/pest": "^3.0|^4.0|^5.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Vaults\\ComposerPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "class": "Vaults\\ComposerPlugin\\VaultsPlugin"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php-client"
        }
    ],
    "scripts": {
        "test": "pest",
        "lint": "pint"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
